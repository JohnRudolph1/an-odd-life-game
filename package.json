{
  "name": "seat-swap-app",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/web",
    "functions",
    "storybook"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web && npm run build -w functions",
    "test": "npm run test -w apps/web",
    "test:e2e": "playwright test",
    "lint": "npm run lint -w apps/web && npm run lint -w functions",
    "emulators": "firebase emulators:start",
    "seed": "npm run seed -w functions",
    "storybook": "npm run storybook -w storybook"
  },
  "devDependencies": {
    "@playwright/test": "^1.53.0",
    "firebase-tools": "^13.15.0"
  }
}
