rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if isSignedIn() && request.auth.uid == uid;

      match /myFlights/{flightId} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
      }
    }

    match /flights/{flightId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        exists(/databases/$(database)/documents/users/$(request.auth.uid)/myFlights/$(flightId))
      );
      allow write: if false;

      match /seats/{seatId} {
        allow read: if isSignedIn() && (
          isAdmin() || exists(/databases/$(database)/documents/users/$(request.auth.uid)/myFlights/$(flightId))
        );
        allow write: if false;
      }

      match /assignments/{uid} {
        allow read: if isSignedIn() && (
          isAdmin() || request.auth.uid == uid ||
          exists(/databases/$(database)/documents/users/$(request.auth.uid)/myFlights/$(flightId))
        );
        allow write: if false;
      }

      match /swapRequests/{requestId} {
        allow read: if isSignedIn() && (
          isAdmin() ||
          resource.data.fromUid == request.auth.uid ||
          resource.data.toUid == request.auth.uid
        );
        allow create, update, delete: if false;
      }

      match /audit/{eventId} {
        allow read: if isAdmin();
        allow write: if false;
      }
    }

    match /seatMapTemplates/{templateId} {
      allow read: if isSignedIn();
      allow write: if false;
    }
  }
}
